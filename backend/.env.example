# Supabase Postgres connection -------------------------------------------------
# Campus Care project: ref npxbvroeczduclahafli, eu-west-1, Postgres 17
# schema applied from supabase/schema.sql
#
# Direct connection (IPv6 only, fine from a normal host):
#   jdbc:postgresql://db.npxbvroeczduclahafli.supabase.co:5432/postgres
# Pooler, session mode (use this if your host has no IPv6, e.g. most PaaS):
#   jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres
#   username becomes postgres.npxbvroeczduclahafli
# Pooler, transaction mode (port 6543) needs ?prepareThreshold=0 in the URL.
#
# The password is the one chosen when the project was created; reset it in
# Supabase -> Settings -> Database if it was lost. Keep it in backend/.env.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.npxbvroeczduclahafli
SUPABASE_DB_PASSWORD=your-database-password

# Browser origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
