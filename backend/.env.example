# Supabase Postgres connection -------------------------------------------------
# Supabase Dashboard -> Connect to your project -> Connection string -> URI
# Direct connection  : jdbc:postgresql://db.<REF>.supabase.co:5432/postgres
# Pooler (serverless) : jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR-REF.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-database-password

# Browser origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
